# Environment
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
DATABASE_URL=sqlite:///./smart_mathai.db

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ollama Local (chấm bài + giải thích — KHÔNG sinh câu hỏi, có thể dùng model nhỏ)
OLLAMA_API_BASE=http://localhost:11434/api
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=300
OLLAMA_KEEP_ALIVE=30m

# Ollama Cloud (OCR + Question Generation)
# Lấy API key tại: https://ollama.com/settings/api-keys
OLLAMA_CLOUD_API_BASE=https://ollama.com/api
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_VISION_MODEL=gemma4:31b
OLLAMA_CLOUD_TIMEOUT=180
OLLAMA_CLOUD_TEXT_MODEL=gemma3:12b
OLLAMA_CLOUD_TEXT_TIMEOUT=600

# Gemini (Chatbot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=120
GEMINI_MAX_OUTPUT_TOKENS=8192

# HuggingFace (suppress warnings)
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_TOKEN=
